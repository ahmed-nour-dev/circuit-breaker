{
    "name": "ahmednour/circuit-breaker",
    "description": "Distributed circuit breaker for Laravel: Redis-backed shared state, single-probe half-open locking, and configurable behaviour when the breaker's own infrastructure fails.",
    "keywords": [
        "laravel",
        "php",
        "circuit-breaker",
        "resilience",
        "fault-tolerance",
        "redis",
        "distributed",
        "octane"
    ],
    "homepage": "https://github.com/ahmed-nour-dev/circuit-breaker",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ahmed Nour",
            "homepage": "https://github.com/ahmed-nour-dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-redis": "*",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/config": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/redis": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "predis/predis": "^2.2 || ^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required for the built-in HTTP failure classifier to recognise Guzzle connection and 5xx exceptions."
    },
    "autoload": {
        "psr-4": {
            "AhmedNour\\CircuitBreaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AhmedNour\\CircuitBreaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhmedNour\\CircuitBreaker\\Providers\\CircuitBreakerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
